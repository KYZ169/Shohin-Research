# docker-compose.yml経由(api/worker/beatコンテナ)で起動する前提のホスト名。
# 本番のConoHa VPS上でもdocker composeで起動する運用のため、db/redisのままで良い。
# (docker-composeを使わずアプリを直接ホスト上で動かす場合のみ、localhost等に変更すること)
DATABASE_URL=postgresql+psycopg2://resale_radar:resale_radar@db:5432/resale_radar
REDIS_URL=redis://redis:6379/0

# Discord Botのトークン。本番運用では必ず実際の値を設定すること
# (未設定のままだとdiscord.pyのクライアントがログインできない)。
DISCORD_BOT_TOKEN=

# FastAPI(Discord Bot Interactionエンドポイント含む)のBearer認証キー。
# 実装仕様書15章: 単一ユーザー前提のAPIキー認証。
# 未設定の場合は認証がスキップされる(app/api/deps.py参照)ため、
# 本番運用では必ず十分な長さのランダム値を設定すること
# (例: `python -c "import secrets; print(secrets.token_urlsafe(32))"`)。
API_KEY=
